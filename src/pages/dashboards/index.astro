---
import Base from "@/layouts/Base.astro";

// Přidání nového dashboardu = jeden objekt níže + jeden nový .astro soubor v tomto adresáři
const dashboards = [
  {
    title: "Trading Backtest Dashboard",
    description:
      "SMA crossover strategie na EUR/USD — equity curve, drawdown, monthly PnL",
    tags: ["EUR/USD", "Backtest", "SMA"],
    url: "/dashboards/trading-backtest",
  },
];
---

<Base
  title="Dashboards"
  meta_title="Dashboards | Jakub Vozar"
  description="Interaktivní dashboardy s výsledky backtestů a analýzou finančních dat."
>
  <section class="section-sm">
    <div class="container">
      <h1 class="h2 mb-2">Dashboards</h1>
      <p class="mb-10 text-light">
        Interaktivní vizualizace výsledků backtestů a datových analýz.
      </p>

      <div class="row gy-4">
        {
          dashboards.map((d) => (
            <div class="md:col-6 lg:col-4">
              <div class="bg-theme-light dark:bg-darkmode-theme-light rounded-xl p-6 flex flex-col h-full">
                <h2 class="h4 mb-3">{d.title}</h2>
                <p class="text-light mb-4 flex-grow">{d.description}</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {d.tags.map((tag) => (
                    <span class="badge badge-outline-primary text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={d.url} class="btn btn-outline-primary btn-sm">
                  Otevřít dashboard →
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
